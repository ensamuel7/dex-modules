import "str"

external module c {
    include "redis_shim.h"
    pkg "hiredis"

    type Pool closed by "redis_shim_pool_free"
    type Socket closed by "redisFree"
    type Args closed by "redis_shim_args_free"
    type Raw closed by "freeReplyObject"

    fn poolNew(host: string, port: int, password: string, size: int): Pool? = "redis_shim_pool_new"
    fn poolCall(p: Pool, a: Args): Raw? = "redis_shim_pool_call"
    fn dial(p: Pool): Socket? = "redis_shim_pool_dial"
    fn send(conn: Socket, a: Args): Raw? = "redis_shim_send"
    fn next(conn: Socket): Raw? = "redis_shim_next"
    fn lastError(): string = "redis_shim_last_error"
    fn argsNew(): Args? = "redis_shim_args_new"
    fn argsPush(a: Args, s: string): void = "redis_shim_args_push"
    fn kind(r: Raw): int = "redis_shim_type"
    fn integer(r: Raw): long = "redis_shim_integer"
    fn str(r: Raw): string = "redis_shim_str"
    fn count(r: Raw): int = "redis_shim_count"
    fn itemKind(r: Raw, i: int): int = "redis_shim_item_type"
    fn itemInteger(r: Raw, i: int): long = "redis_shim_item_integer"
    fn itemStr(r: Raw, i: int): string = "redis_shim_item_str"
}

const STRING: int = 1
const ARRAY: int = 2
const INTEGER: int = 3
const NIL: int = 4
const STATUS: int = 5
const ERROR: int = 6
const POOL_SIZE: int = 8

struct RedisError(message: string) {}

enum Kind {
    Text
    Number
    List
    Nil
    Status
}

struct Reply {
    kind: Kind
    text: string
    number: long
    items: string[]
}

struct Message {
    channel: string
    pattern: string
    payload: string
}

private fn argsOf(args: string[]): Args throws RedisError {
    let a: Args? = c.argsNew()
    if (a == null) {
        throw RedisError("out of memory")
    }
    foreach (args as arg) {
        c.argsPush(a, arg)
    }
    return a
}

private fn itemsOf(r: Raw): string[] {
    let items: string[] = []
    let n: int = c.count(r)
    for (let i: int = 0; i < n; i++) {
        if (c.itemKind(r, i) == INTEGER) {
            items.push(str.fromLong(c.itemInteger(r, i)))
        } else {
            items.push(c.itemStr(r, i))
        }
    }
    return items
}

private fn replyOf(raw: Raw?): Reply throws RedisError {
    if (raw == null) {
        throw RedisError(c.lastError())
    }
    let k: int = c.kind(raw)
    if (k == ERROR) {
        throw RedisError(c.str(raw))
    }
    if (k == INTEGER) {
        return Reply { kind: Kind.Number, text: "", number: c.integer(raw), items: [] }
    }
    if (k == NIL) {
        return Reply { kind: Kind.Nil, text: "", number: 0, items: [] }
    }
    if (k == STATUS) {
        return Reply { kind: Kind.Status, text: c.str(raw), number: 0, items: [] }
    }
    if (k == ARRAY) {
        return Reply { kind: Kind.List, text: "", number: 0, items: itemsOf(raw) }
    }
    return Reply { kind: Kind.Text, text: c.str(raw), number: 0, items: [] }
}

struct Subscriber {
    conn: Socket

    fn subscribe(channel: string): void throws RedisError {
        replyOf(c.send(self.conn, argsOf(["SUBSCRIBE", channel])))
    }

    fn psubscribe(pattern: string): void throws RedisError {
        replyOf(c.send(self.conn, argsOf(["PSUBSCRIBE", pattern])))
    }

    fn next(): Message? {
        while (true) {
            let raw: Raw? = c.next(self.conn)
            if (raw == null) {
                return null
            }
            if (c.kind(raw) == ARRAY) {
                let items: string[] = itemsOf(raw)
                if (items.len() == 3 && items[0] == "message") {
                    return Message { channel: items[1], pattern: "", payload: items[2] }
                }
                if (items.len() == 4 && items[0] == "pmessage") {
                    return Message { channel: items[2], pattern: items[1], payload: items[3] }
                }
            }
        }
        return null
    }
}

struct Client {
    pool: Pool

    fn command(args: string[]): Reply throws RedisError {
        return replyOf(c.poolCall(self.pool, argsOf(args)))
    }

    fn subscribe(channel: string): Subscriber throws RedisError {
        let conn: Socket? = c.dial(self.pool)
        if (conn == null) {
            throw RedisError(c.lastError())
        }
        let sub: Subscriber = Subscriber { conn: conn }
        sub.subscribe(channel)
        return sub
    }

    fn ping(): string throws RedisError {
        return self.command(["PING"]).text
    }

    fn set(key: string, value: string): void throws RedisError {
        self.command(["SET", key, value])
    }

    fn setex(key: string, value: string, seconds: int): void throws RedisError {
        self.command(["SET", key, value, "EX", str.fromInt(seconds)])
    }

    fn get(key: string): string? throws RedisError {
        let r: Reply = self.command(["GET", key])
        if (r.kind == Kind.Nil) {
            return null
        }
        return r.text
    }

    fn del(key: string): long throws RedisError {
        return self.command(["DEL", key]).number
    }

    fn exists(key: string): bool throws RedisError {
        return self.command(["EXISTS", key]).number > 0
    }

    fn incr(key: string): long throws RedisError {
        return self.command(["INCR", key]).number
    }

    fn incrBy(key: string, by: long): long throws RedisError {
        return self.command(["INCRBY", key, str.fromLong(by)]).number
    }

    fn expire(key: string, seconds: int): bool throws RedisError {
        return self.command(["EXPIRE", key, str.fromInt(seconds)]).number == 1
    }

    fn ttl(key: string): long throws RedisError {
        return self.command(["TTL", key]).number
    }

    fn keys(pattern: string): string[] throws RedisError {
        return self.command(["KEYS", pattern]).items
    }

    fn hset(key: string, field: string, value: string): long throws RedisError {
        return self.command(["HSET", key, field, value]).number
    }

    fn hget(key: string, field: string): string? throws RedisError {
        let r: Reply = self.command(["HGET", key, field])
        if (r.kind == Kind.Nil) {
            return null
        }
        return r.text
    }

    fn hgetall(key: string): map[string, string] throws RedisError {
        let items: string[] = self.command(["HGETALL", key]).items
        let out: map[string, string] = {}
        for (let i: int = 0; i + 1 < items.len(); i += 2) {
            out.set(items[i], items[i + 1])
        }
        return out
    }

    fn lpush(key: string, value: string): long throws RedisError {
        return self.command(["LPUSH", key, value]).number
    }

    fn rpush(key: string, value: string): long throws RedisError {
        return self.command(["RPUSH", key, value]).number
    }

    fn lrange(key: string, start: int, stop: int): string[] throws RedisError {
        return self.command(["LRANGE", key, str.fromInt(start), str.fromInt(stop)]).items
    }

    fn hdel(key: string, field: string): long throws RedisError {
        return self.command(["HDEL", key, field]).number
    }

    fn hkeys(key: string): string[] throws RedisError {
        return self.command(["HKEYS", key]).items
    }

    fn sadd(key: string, member: string): long throws RedisError {
        return self.command(["SADD", key, member]).number
    }

    fn srem(key: string, member: string): long throws RedisError {
        return self.command(["SREM", key, member]).number
    }

    fn sismember(key: string, member: string): bool throws RedisError {
        return self.command(["SISMEMBER", key, member]).number == 1
    }

    fn smembers(key: string): string[] throws RedisError {
        return self.command(["SMEMBERS", key]).items
    }

    fn publish(channel: string, message: string): long throws RedisError {
        return self.command(["PUBLISH", channel, message]).number
    }
}

fn connect(host: string, port: int, password: string): Client throws RedisError {
    return connectPool(host, port, password, POOL_SIZE)
}

fn connectPool(host: string, port: int, password: string, size: int): Client throws RedisError {
    let pool: Pool? = c.poolNew(host, port, password, size)
    if (pool == null) {
        throw RedisError(c.lastError())
    }
    return Client { pool: pool }
}
