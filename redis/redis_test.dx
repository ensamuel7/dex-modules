import "fmt"
import "str"
import "github.com/ensamuel7/dex-modules/redis"

fn run(): void throws redis.RedisError {
    let r: redis.Client = redis.connect("127.0.0.1", 6379, "")
    assert(r.ping() == "PONG")

    r.del("dexmod:name")
    assert(r.get("dexmod:name") == null)
    r.set("dexmod:name", "hello world")
    let name: string? = r.get("dexmod:name")
    assert(name != null)
    if (name != null) {
        assert(name == "hello world")
    }
    assert(r.exists("dexmod:name"))
    assert(r.del("dexmod:name") == 1)
    assert(!r.exists("dexmod:name"))

    r.del("dexmod:count")
    assert(r.incr("dexmod:count") == 1)
    assert(r.incrBy("dexmod:count", 41) == 42)
    assert(r.expire("dexmod:count", 60))
    assert(r.ttl("dexmod:count") > 0)

    r.del("dexmod:list")
    r.rpush("dexmod:list", "a")
    r.rpush("dexmod:list", "b")
    r.lpush("dexmod:list", "z")
    let list: string[] = r.lrange("dexmod:list", 0, -1)
    assert(list.len() == 3)
    assert(list[0] == "z")
    assert(list[2] == "b")

    r.del("dexmod:user")
    r.hset("dexmod:user", "name", "ada")
    r.hset("dexmod:user", "lang", "dex")
    let user: map[string, string] = r.hgetall("dexmod:user")
    assert(user.len() == 2)
    assert(user.get("lang") == "dex")
    assert(r.hget("dexmod:user", "missing") == null)

    r.setex("dexmod:session", "x", 30)
    assert(r.keys("dexmod:*").len() == 4)

    let reply: redis.Reply = r.command(["ECHO", "100% safe %s"])
    assert(reply.text == "100% safe %s")

    let caught: bool = false
    try {
        r.command(["NOT_A_COMMAND"])
    } catch (e: redis.RedisError) {
        caught = true
        assert(e.message.contains("unknown command"))
    }
    assert(caught)

    let badAuth: bool = false
    try {
        redis.connect("127.0.0.1", 6379, "not-the-password")
    } catch (e: redis.RedisError) {
        badAuth = true
        assert(e.message.contains("AUTH"))
    }
    assert(badAuth)

    let refused: bool = false
    try {
        redis.connect("127.0.0.1", 1, "")
    } catch (e: redis.RedisError) {
        refused = true
    }
    assert(refused)

    for (let i: int = 0; i < 200; i++) {
        r.set("dexmod:loop", str.fromInt(i))
    }
    r.del("dexmod:count")
    r.del("dexmod:list")
    r.del("dexmod:user")
    r.del("dexmod:session")
    r.del("dexmod:loop")
}

fn bump(r: redis.Client, times: int): int {
    let done: int = 0
    try {
        for (let i: int = 0; i < times; i++) {
            r.incr("dexmod:shared")
            done++
        }
    } catch (e: redis.RedisError) {
        return -1
    }
    return done
}

fn pubsub(r: redis.Client): void throws redis.RedisError {
    let sub: redis.Subscriber = r.subscribe("dexmod:chan")
    sub.psubscribe("dexmod:pat:*")
    r.publish("dexmod:chan", "one")
    r.publish("dexmod:pat:x", "two")
    r.publish("dexmod:chan", "three has spaces")
    let m1: redis.Message? = sub.next()
    let m2: redis.Message? = sub.next()
    let m3: redis.Message? = sub.next()
    assert(m1 != null && m2 != null && m3 != null)
    if (m1 != null) {
        assert(m1.channel == "dexmod:chan")
        assert(m1.payload == "one")
    }
    if (m2 != null) {
        assert(m2.channel == "dexmod:pat:x")
        assert(m2.pattern == "dexmod:pat:*")
        assert(m2.payload == "two")
    }
    if (m3 != null) {
        assert(m3.payload == "three has spaces")
    }
}

fn listen(sub: redis.Subscriber, count: int): string {
    let got: string = ""
    for (let i: int = 0; i < count; i++) {
        let m: redis.Message? = sub.next()
        if (m == null) {
            return got + "<dropped>"
        }
        got = got + m.payload + ";"
    }
    return got
}

fn background(r: redis.Client): void throws redis.RedisError {
    let sub: redis.Subscriber = r.subscribe("dexmod:jobs")
    let ch = channel(string)
    spawn {
        send(ch, listen(sub, 3))
    }
    r.publish("dexmod:jobs", "a")
    r.publish("dexmod:jobs", "b")
    r.publish("dexmod:jobs", "c")
    assert(receive(ch) == "a;b;c;")
}

fn threads(r: redis.Client): void throws redis.RedisError {
    r.del("dexmod:shared")
    let ch = channel(int)
    for (let t: int = 0; t < 16; t++) {
        spawn {
            send(ch, bump(r, 50))
        }
    }
    let total: int = 0
    for (let t: int = 0; t < 16; t++) {
        total += receive(ch)
    }
    assert(total == 800)
    let count: string? = r.get("dexmod:shared")
    if (count != null) {
        assert(count == "800")
    }
    r.del("dexmod:shared")
}

fn main(): void {
    try {
        run()
        let r: redis.Client = redis.connect("127.0.0.1", 6379, "")
        pubsub(r)
        background(r)
        threads(r)
        let small: redis.Client = redis.connectPool("127.0.0.1", 6379, "", 2)
        threads(small)
        fmt.println("redis_test: all assertions passed")
    } catch (e: redis.RedisError) {
        fmt.println("redis_test failed: " + e.message)
        assert(false)
    }
}
